# ReClaim AWS Integration Environment Configuration
# Copy this file to .env when connecting your AWS infrastructure:
#   cp .env.example .env

# Set to "true" to switch from local mock adapters to live AWS backend
VITE_USE_AWS_BACKEND=false

# Amazon API Gateway REST API Base URL
VITE_API_GATEWAY_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod

# Amazon Cognito Configuration
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_REGION=us-east-1

# Amazon S3 / CloudFront Configuration
VITE_S3_BUCKET_NAME=reclaim-item-images-bucket
VITE_CLOUDFRONT_DOMAIN=https://dxxxxxxxxxxxx.cloudfront.net
